# Application URL used for canonical and Open Graph metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings. Use the browser-safe publishable/anon key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only key required by /admin/feedbacks moderation actions.
# Never expose this value to the browser or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Prisma pooled runtime connection and direct migration connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/gabonconnect
DIRECT_URL=postgresql://postgres:password@localhost:5432/gabonconnect

# Optional locale override. Supported values: fr, en. Default: fr.
I18N_DEFAULT_LOCALE=fr

# Optional: OpenAI API key for RAG embeddings (text-embedding-3-small). Without it,
# the vector store falls back to a local deterministic embedding for dev/tests.
OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small
