generator client {
  provider = "prisma-client-js" // <-- CORRIGÉ ICI
  output   = "../app/generated/prisma"
}

 datasource db {
  provider = "postgresql"
   // url / directUrl sont définis dans prisma.config.ts (système Prisma 7)
} 




enum Role {
  USER
  ADMIN
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum AssociationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Continent {
  id   String @id @default(uuid())
  name String
  slug String @unique
  code String @unique

  countries Country[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("continents")
}

model Country {
  id   String @id @default(uuid())
  name String
  slug String @unique
  code String @unique

  continentId String
  continent   Continent @relation(fields: [continentId], references: [id], onDelete: Restrict)

  cities City[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([continentId])
  @@map("countries")
}

model City {
  id   String @id @default(uuid())
  name String
  slug String @unique

  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  latitude  Float
  longitude Float

  profiles     Profile[]
  associations Association[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
  @@map("cities")
}

model User {
  id    String @id
  email String @unique
  role  Role   @default(USER)

  profile Profile?

  importBatchesCreated  ImportBatch[]  @relation("ImportBatchCreator")
  importBatchesReviewed ImportBatch[]  @relation("ImportBatchReviewer")
  importRecordsImported ImportRecord[] @relation("ImportRecordImporter")
  importRecordsReviewed ImportRecord[] @relation("ImportRecordReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Profile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName  String
  lastName   String
  bio        String?
  profession String?
  photo      String?

  connectionsSent     Connection[] @relation("ConnectionRequester")
  connectionsReceived Connection[] @relation("ConnectionReceiver")

  visibility ProfileVisibility @default(PUBLIC)

  cityId String?
  city   City?   @relation(fields: [cityId], references: [id], onDelete: Restrict)

  associations AssociationMember[] 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId])
  @@index([visibility])
  @@map("profiles")
}

model Association {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  logo        String?
  website     String?
  email       String?
  phone       String?

  cityId String?
  city   City?   @relation(fields: [cityId], references: [id], onDelete: Restrict)

  status AssociationStatus @default(PENDING)

  members AssociationMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId])
  @@index([status])
  @@map("associations")
}

model AssociationMember {
  id String @id @default(uuid())

  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([associationId, profileId])
  @@index([associationId])
  @@index([profileId])
  @@map("association_members")
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ImportBatchStatus {
  DRAFT
  VALIDATED
  REJECTED
  IMPORTED
}

enum ImportRecordStatus {
  IMPORTED
  VALIDATED
  REJECTED
}

enum ImportEntityType {
  ASSOCIATION
  COMPANY
  PERSONALITY
}

model Connection {
  id          String           @id @default(uuid())
  requesterId String
  requester   Profile          @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    Profile          @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([receiverId])
  @@index([requesterId])
  @@map("connections")
}

model ImportBatch {
  id           String            @id @default(uuid())
  source       String
  sourceType   String
  sourceUrl    String?
  status       ImportBatchStatus @default(DRAFT)
  createdById  String
  createdBy    User              @relation("ImportBatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedById String?
  reviewedBy   User?             @relation("ImportBatchReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  reviewedAt   DateTime?

  records ImportRecord[]

  @@index([status])
  @@index([createdById])
  @@map("import_batches")
}

model ImportRecord {
  id                String             @id @default(uuid())
  batchId           String
  batch             ImportBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  entityType        ImportEntityType
  rowNumber         Int
  externalId        String?
  sourceExternalKey String?
  normalizedName    String
  dedupeKey         String
  payload           Json
  status            ImportRecordStatus  @default(IMPORTED)
  importedAt        DateTime            @default(now())
  importedById      String
  importedBy        User                @relation("ImportRecordImporter", fields: [importedById], references: [id], onDelete: Restrict)
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        User?               @relation("ImportRecordReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason   String?

  @@unique([batchId, rowNumber])
  @@unique([entityType, dedupeKey])
  @@unique([sourceExternalKey])
  @@index([batchId, status])
  @@index([status])
  @@map("import_records")
}
