generator client {
  provider = "prisma-client-js" // <-- CORRIGÉ ICI
  output   = "../app/generated/prisma"
}

 datasource db {
  provider = "postgresql"
   // url / directUrl sont définis dans prisma.config.ts (système Prisma 7)
} 




enum Role {
  USER
  ADMIN
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum AssociationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ArticleCategory {
  GABON
  INTERNATIONAL
  DIASPORA
  STUDENTS
  CAMPUS
  OPPORTUNITIES
  POLITICS
  ECONOMY
  CULTURE
  SPORTS
  SPORT
  ADMINISTRATIVE
}

enum NotificationType {
  NEWS
  EVENT
  OPPORTUNITY
  CAMPUS
  SYSTEM
  MESSAGE
}

enum AssociationCategory {
  CULTURE
  EDUCATION
  BUSINESS
  SOLIDARITY
  SPORT
}

enum AssociationMemberRole {
  MEMBER
  ADMIN
  TREASURER
  SECRETARY
}

enum AssociationMemberStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConsulateType {
  EMBASSY
  CONSULATE_GENERAL
  HONORARY_CONSULATE
}

enum AdministrativeProcedureCategory {
  CONSULAR
  IMMIGRATION
  INTEGRATION
  RETURN
}

enum ProcedureContentType {
  OFFICIAL_DOCUMENTED
  GABONCONNECT_EXPLANATORY
}

enum UserProcedureStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ScholarshipLevel {
  LICENCE
  MASTER
  DOCTORAT
}

enum HousingType {
  COLOCATION
  STUDIO
  CHAMBRE
  SOUS_LOCATION
}

enum ContentModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SourceRegistryType {
  GOVERNMENT
  DIPLOMATIC
  MEDIA
  UNIVERSITY
  DIASPORA
  OTHER
}

enum MemberStatus {
  STUDENT
  PROFESSIONAL
  ENTREPRENEUR
  ARTIST
  OTHER
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum EmbeddingSourceType {
  ARTICLE
  ADMINISTRATIVE_PROCEDURE
  SCHOLARSHIP
  EVENT
  OPPORTUNITY
  SOURCE_REGISTRY
  HISTORICAL_EVENT
  HISTORICAL_FIGURE
  HISTORICAL_ARCHIVE
  DIASPORA_IMPACT
}

enum CommunityFeedbackStatus {
  PENDING
  PUBLISHED
  HIDDEN
  PROCESSED
  ARCHIVED
}

enum HistoricalScope {
  GABON_INTERIOR
  DIASPORA
  BOTH
}

enum HistoricalStatus {
  FACT
  OFFICIAL_POSITION
  ACADEMIC_ANALYSIS
  TESTIMONY
  CONTROVERSIAL
}

enum SourceLevel {
  LEVEL_A
  LEVEL_B
  LEVEL_C
  LEVEL_D
}

model Continent {
  id   String @id @default(uuid())
  name String
  slug String @unique
  code String @unique

  countries Country[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("continents")
}

model Country {
  id   String @id @default(uuid())
  name String
  slug String @unique
  code String @unique

  continentId String
  continent   Continent @relation(fields: [continentId], references: [id], onDelete: Restrict)

  cities City[]
  userPreferences UserPreferences[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([continentId])
  @@map("countries")
}

model City {
  id   String @id @default(uuid())
  name String
  slug String @unique

  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  latitude  Float
  longitude Float

  profiles     Profile[]
  associations Association[]
  userPreferences UserPreferences[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
  @@map("cities")
}

model User {
  id    String @id
  email String @unique
  role  Role   @default(USER)

  profile Profile?

  importBatchesCreated  ImportBatch[]  @relation("ImportBatchCreator")
  importBatchesReviewed ImportBatch[]  @relation("ImportBatchReviewer")
  importRecordsImported ImportRecord[] @relation("ImportRecordImporter")
  importRecordsReviewed ImportRecord[] @relation("ImportRecordReviewer")
  importRecordsPublished ImportRecord[] @relation("ImportRecordPublisher")
  articles              Article[]       @relation("ArticleAuthor")
  announcementsOwned    Announcement[]  @relation("AnnouncementOwner")
  shopsOwned            Shop[]          @relation("ShopOwner")
  consents              UserConsent[]
  eventsCreated         Event[]        @relation("EventCreator")
  eventParticipations   EventParticipant[]
  opportunitiesCreated  Opportunity[]     @relation("OpportunityCreator")
  opportunityApplications OpportunityApplication[]
  savedOpportunities      SavedOpportunity[]
  posts                 Post[]                 @relation("PostAuthor")
  postLikes             PostLike[]
  postComments          PostComment[]         @relation("PostCommentAuthor")
  conversationsAsFirst  Conversation[]       @relation("ConversationParticipant1")
  conversationsAsSecond Conversation[]       @relation("ConversationParticipant2")
  sentMessages          Message[]             @relation("MessageSender")
  notifications         Notification[]
  notificationPreference NotificationPreference?
  procedureProgress       UserProcedureProgress[]
  housingOffers            HousingOffer[]
  associationMemberships   AssociationMember[] @relation("AssociationMemberUser")
  presidedAssociations     Association[] @relation("AssociationPresident")
  preferences              UserPreferences?
  communityFeedbacks       CommunityFeedback[]
  communityFeedbackVotes   CommunityFeedbackVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model SourceRegistry {
  id              String             @id @default(cuid())
  name            String
  url             String             @unique
  type            SourceRegistryType
  country         String             @default("GA")
  language        String             @default("fr")
  rssUrl          String?
  active          Boolean            @default(true)
  reliability     Float              @default(3)
  lastFetchedAt   DateTime?
  termsUrl        String?
  targetAudiences String[]           @default([])
  ingestionLogs   IngestionLog[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([active, type])
  @@index([country, language])
  @@index([lastFetchedAt])
  @@map("source_registry")
}

model IngestionLog {
  id             String         @id @default(uuid())
  sourceId       String
  source         SourceRegistry @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  fetched        Int            @default(0)
  created        Int            @default(0)
  duplicates     Int            @default(0)
  failed         Boolean        @default(false)
  autoPublished  Int            @default(0)
  humanReview    Int            @default(0)
  quarantined    Int            @default(0)
  durationMs     Int
  createdAt      DateTime       @default(now())

  @@index([createdAt])
  @@index([sourceId, createdAt])
  @@map("ingestion_logs")
}

model Profile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName  String
  lastName   String
  bio        String?
  profession String?
  photo      String?

  connectionsSent     Connection[] @relation("ConnectionRequester")
  connectionsReceived Connection[] @relation("ConnectionReceiver")

  visibility ProfileVisibility @default(PUBLIC)
  status     UserStatus        @default(OFFLINE)
  showStatus Boolean           @default(true)

  isVerified        Boolean            @default(false)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt        DateTime?
  verificationNotes String?

  cityId String?
  city   City?   @relation(fields: [cityId], references: [id], onDelete: Restrict)

  associations AssociationMember[] 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId])
  @@index([visibility])
  @@map("profiles")
}

model Association {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  logo        String?
  website     String?
  email       String?
  phone       String?
  logoUrl     String?
  category    AssociationCategory @default(SOLIDARITY)
  address     String?
  presidentId String?
  president   User? @relation("AssociationPresident", fields: [presidentId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  archivedAt DateTime?
  moderationStatus ContentModerationStatus @default(APPROVED)
  canonicalUrl String?
  sourceName String?
  copyrightFlag Boolean @default(false)

  cityId String?
  city   City?   @relation(fields: [cityId], references: [id], onDelete: Restrict)

  status AssociationStatus @default(PENDING)

  isVerified        Boolean            @default(false)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt        DateTime?
  verificationNotes String?

  members AssociationMember[]
  shops   Shop[]
  events  Event[]
  opportunities Opportunity[]
  posts         Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId])
  @@index([status])
  @@index([moderationStatus, publishedAt])
  @@map("associations")
}

model AssociationMember {
  id String @id @default(uuid())

  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId    String
  user      User @relation("AssociationMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role      AssociationMemberRole @default(MEMBER)
  status    AssociationMemberStatus @default(PENDING)
  joinedAt  DateTime?

  createdAt DateTime @default(now())

  @@unique([associationId, profileId])
  @@index([associationId])
  @@index([profileId])
  @@index([userId, status])
  @@map("association_members")
}

model Consulate {
  id            String        @id @default(cuid())
  name          String
  type          ConsulateType
  country       String
  city          String
  address       String
  phone         String
  email         String
  website       String
  openingHours  String
  jurisdiction  String
  latitude      Float
  longitude     Float
  createdAt     DateTime      @default(now())

  @@index([country, type])
  @@map("consulates")
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ImportBatchStatus {
  DRAFT
  VALIDATED
  REJECTED
  IMPORTED
}

enum ImportRecordStatus {
  IMPORTED
  VALIDATED
  REJECTED
}

enum ImportEntityType {
  ASSOCIATION
  COMPANY
  PERSONALITY
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnnouncementStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AnnouncementTargetType {
  ASSOCIATION
  CONTINENT
  COUNTRY
  CITY
}

enum ShopStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ConsentType {
  ADVERTISING
  COMMUNICATIONS
}

enum EventOrganizerType {
  ASSOCIATION
  USER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum EventParticipantStatus {
  GOING
  MAYBE
  DECLINED
}

enum OpportunityType {
  JOB
  INTERNSHIP
  VOLUNTEERING
  PROJECT_CALL
  MUTUAL_AID
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum OpportunityApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

enum PostVisibility {
  PUBLIC
  MEMBERS_ONLY
}

enum PostType {
  GENERAL
  ANNOUNCEMENT
  EVENT_SHARE
  OPPORTUNITY_SHARE
}

enum UserStatus {
  ONLINE
  AWAY
  BUSY
  OFFLINE
  INCOGNITO
}

model Connection {
  id          String           @id @default(uuid())
  requesterId String
  requester   Profile          @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    Profile          @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([receiverId])
  @@index([requesterId])
  @@map("connections")
}

model ImportBatch {
  id           String            @id @default(uuid())
  source       String
  sourceType   String
  sourceUrl    String?
  status       ImportBatchStatus @default(DRAFT)
  createdById  String
  createdBy    User              @relation("ImportBatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedById String?
  reviewedBy   User?             @relation("ImportBatchReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  reviewedAt   DateTime?

  records ImportRecord[]

  @@index([status])
  @@index([createdById])
  @@map("import_batches")
}

model ImportRecord {
  id                String             @id @default(uuid())
  batchId           String
  batch             ImportBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  entityType        ImportEntityType
  rowNumber         Int
  externalId        String?
  sourceExternalKey String?
  normalizedName    String
  dedupeKey         String
  payload           Json
  status            ImportRecordStatus  @default(IMPORTED)
  importedAt        DateTime            @default(now())
  importedById      String
  importedBy        User                @relation("ImportRecordImporter", fields: [importedById], references: [id], onDelete: Restrict)
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        User?               @relation("ImportRecordReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason   String?
  publishedAt       DateTime?
  publishedById     String?
  publishedBy       User?               @relation("ImportRecordPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedEntityId String?

  @@unique([batchId, rowNumber])
  @@unique([entityType, dedupeKey])
  @@unique([sourceExternalKey])
  @@index([batchId, status])
  @@index([status])
  @@index([publishedEntityId])
  @@map("import_records")
}

model Article {
  id          String        @id @default(uuid())
  authorId    String
  author      User          @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  title       String
  slug        String        @unique
  summary     String?
  content     String
  imageUrl    String?
  category    ArticleCategory @default(GABON)
  viewCount   Int             @default(0)
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?
  archivedAt DateTime?
  moderationStatus ContentModerationStatus @default(APPROVED)
  canonicalUrl String?
  contentHash  String?
  sourceName String?
  copyrightFlag Boolean @default(false)
  relevanceDecision Json?
  relevanceScore Float?
  relevanceLevel String?
  sourceLevel SourceLevel?
  reviewReason String?
  reviewedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([category, publishedAt])
  @@index([authorId])
  @@index([moderationStatus, publishedAt])
  @@index([moderationStatus, reviewedAt])
  @@index([relevanceLevel])
  @@index([contentHash])
  @@map("articles")
}

model Announcement {
  id          String             @id @default(uuid())
  ownerId     String
  owner       User               @relation("AnnouncementOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  title       String
  description String
  imageUrl    String?
  destination String?
  status      AnnouncementStatus @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  targets AnnouncementTarget[]

  @@index([status, startsAt, endsAt])
  @@index([ownerId])
  @@map("announcements")
}

model AnnouncementTarget {
  id             String                @id @default(uuid())
  announcementId String
  announcement   Announcement          @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  type           AnnouncementTargetType
  value          String
  createdAt      DateTime              @default(now())

  @@unique([announcementId, type, value])
  @@index([type, value])
  @@map("announcement_targets")
}

model Shop {
  id           String     @id @default(uuid())
  ownerId      String
  owner        User       @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  associationId String?
  association  Association? @relation(fields: [associationId], references: [id], onDelete: SetNull)
  name         String
  slug         String     @unique
  description  String?
  status       ShopStatus @default(DRAFT)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  publishedAt DateTime?
  archivedAt DateTime?
  moderationStatus ContentModerationStatus @default(APPROVED)
  canonicalUrl String?
  sourceName String?
  copyrightFlag Boolean @default(false)

  products Product[]

  @@index([status])
  @@index([ownerId])
  @@index([associationId])
  @@index([moderationStatus, publishedAt])
  @@map("shops")
}

model Product {
  id          String        @id @default(uuid())
  shopId      String
  shop        Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String?
  price       Decimal?      @db.Decimal(12, 2)
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([shopId, status])
  @@map("products")
}

model UserConsent {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  granted   Boolean     @default(false)
  grantedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, type])
  @@index([type, granted])
  @@map("user_consents")
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  message   String
  link      String?
  isRead    Boolean             @default(false)
  createdAt DateTime            @default(now())

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  inApp   Boolean @default(true)
  email   Boolean @default(false)
  push    Boolean @default(false)
  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

// Personnalisation V0.3.0 : ciblage du feed/notifications par localisation, statut et centres d'interet.
model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  countryId String?
  country   Country? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  cityId    String?
  city      City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)

  memberStatus      MemberStatus          @default(OTHER)
  interests         String[]              @default([])
  preferredChannels NotificationChannel[] @default([IN_APP])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
  @@index([cityId])
  @@index([memberStatus])
  @@map("user_preferences")
}

// Reference d'embedding pour l'assistant IA RAG (Task 061). Vecteur stocke en Float[] en attendant
// l'activation de l'extension pgvector et sa migration dediee ; ce modele fixe la forme des donnees des maintenant.
model ContentEmbedding {
  id         String              @id @default(cuid())
  sourceType EmbeddingSourceType
  sourceId   String
  locale     String              @default("fr")
  chunkIndex Int                 @default(0)
  content    String              @db.Text
  embedding  Float[]             @default([])
  provider   String?
  model      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceType, sourceId, locale, chunkIndex])
  @@index([sourceType, sourceId])
  @@map("content_embeddings")
}

// Module "La Voix de la Communaute" (V0.3.0). Table distincte de la table Supabase historique `feedbacks`,
// dont la migration de donnees est traitee separement (Task 066) pour rester non destructive ici.
model CommunityFeedback {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  locale      String                  @default("fr")
  likes       String?
  ideas       String?
  dislikes    String?
  bugs        String?
  status      CommunityFeedbackStatus @default(PENDING)
  isPublished Boolean                 @default(false)

  votes CommunityFeedbackVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@map("community_feedbacks")
}

model CommunityFeedbackVote {
  id         String            @id @default(cuid())
  feedbackId String
  feedback   CommunityFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([feedbackId, userId])
  @@index([feedbackId])
  @@map("community_feedback_votes")
}

model HistoricalEvent {
  id                String           @id @default(cuid())
  title             String
  period            String
  exactDate         DateTime?
  description       String           @db.Text
  historicalStatus  HistoricalStatus
  sourceLevel       SourceLevel
  scope             HistoricalScope
  relevanceDecision Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([scope, exactDate])
  @@index([historicalStatus, sourceLevel])
  @@map("historical_events")
}

model HistoricalFigure {
  id                String           @id @default(cuid())
  fullName          String
  category          String
  biography         String           @db.Text
  mainImpact        String           @db.Text
  historicalStatus  HistoricalStatus
  sourceLevel       SourceLevel
  scope             HistoricalScope
  relevanceDecision Json?
  diasporaImpacts   DiasporaImpact[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([scope, category])
  @@index([historicalStatus, sourceLevel])
  @@map("historical_figures")
}

model HistoricalArchive {
  id                String      @id @default(cuid())
  title             String
  actDate           DateTime?
  legalNature       String
  sourceLevel       SourceLevel
  documentUrl       String?
  relevanceDecision Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([actDate])
  @@index([sourceLevel])
  @@map("historical_archives")
}

model DiasporaImpact {
  id                String            @id @default(cuid())
  figureId          String?
  figure            HistoricalFigure? @relation(fields: [figureId], references: [id], onDelete: Cascade)
  country           String
  city              String?
  period            String
  domain            String
  contribution      String            @db.Text
  sourceLevel       SourceLevel
  relevanceDecision Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([figureId])
  @@index([country, city])
  @@index([domain])
  @@map("diaspora_impacts")
}

model AdministrativeProcedure {
  id            String                         @id @default(cuid())
  slug          String                         @unique
  title         String
  description   String
  category      AdministrativeProcedureCategory
  estimatedDays Int
  cost          String
  officialUrl   String
  contentType   ProcedureContentType @default(GABONCONNECT_EXPLANATORY)
  targetAudience String?
  conditions    String?
  requiredDocuments String[] @default([])
  competentAuthority String?
  verifiedAt    DateTime?
  steps         ProcedureStep[]
  progress      UserProcedureProgress[]
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
  publishedAt   DateTime?
  archivedAt    DateTime?
  moderationStatus ContentModerationStatus     @default(APPROVED)
  canonicalUrl  String?
  sourceName    String?
  copyrightFlag Boolean                        @default(false)
  relevanceDecision Json?

  @@index([category])
  @@index([contentType, verifiedAt])
  @@map("administrative_procedures")
}

model ProcedureStep {
  id          String                  @id @default(cuid())
  procedureId String
  procedure   AdministrativeProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  description String
  isRequired  Boolean                 @default(true)

  @@unique([procedureId, order])
  @@map("procedure_steps")
}

model UserProcedureProgress {
  id               String                  @id @default(cuid())
  userId           String
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  procedureId      String
  procedure        AdministrativeProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  status           UserProcedureStatus      @default(NOT_STARTED)
  completedStepIds String[]                 @default([])
  updatedAt        DateTime                @updatedAt

  @@unique([userId, procedureId])
  @@index([userId, status])
  @@map("user_procedure_progress")
}

model Scholarship {
  id                 String           @id @default(cuid())
  title              String
  provider           String
  country            String
  level              ScholarshipLevel
  description        String
  eligibilityCriteria String
  deadline           DateTime
  applicationUrl     String
  createdAt          DateTime         @default(now())
  publishedAt        DateTime?
  archivedAt         DateTime?
  moderationStatus   ContentModerationStatus @default(APPROVED)
  canonicalUrl       String?
  sourceName         String?
  copyrightFlag      Boolean          @default(false)
  relevanceDecision  Json?

  @@index([country, level, deadline])
  @@index([provider, deadline])
  @@map("scholarships")
}

model HousingOffer {
  id          String      @id @default(cuid())
  authorId    String
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  city        String
  country     String
  type        HousingType
  price       Float
  description String
  contactEmail String
  isAvailable Boolean     @default(true)
  createdAt   DateTime    @default(now())

  @@index([country, city, type, isAvailable])
  @@index([authorId, createdAt])
  @@map("housing_offers")
}

model Event {
  id              String              @id @default(cuid())
  title           String
  slug            String              @unique
  description     String              @db.Text
  startDate       DateTime
  endDate         DateTime?
  location        String
  isVirtual       Boolean             @default(false)
  virtualUrl      String?
  organizerType   EventOrganizerType
  associationId   String?
  association     Association?        @relation(fields: [associationId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User                @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  maxParticipants Int?
  status          EventStatus         @default(PUBLISHED)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  publishedAt     DateTime?
  archivedAt      DateTime?
  moderationStatus ContentModerationStatus @default(APPROVED)
  canonicalUrl    String?
  sourceName      String?
  copyrightFlag   Boolean             @default(false)
  relevanceDecision Json?
  registrationUrl String?

  participants EventParticipant[]

  @@index([status, startDate])
  @@index([associationId, startDate])
  @@index([createdById])
  @@map("events")
}

model EventParticipant {
  id        String                  @id @default(cuid())
  eventId   String
  event     Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    EventParticipantStatus  @default(GOING)
  createdAt DateTime                @default(now())

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
  @@map("event_participants")
}

model Opportunity {
  id             String          @id @default(cuid())
  title          String
  slug           String          @unique
  description    String          @db.Text
  type           OpportunityType
  location       String
  isRemote       Boolean         @default(false)
  companyName    String?
  applicationUrl String?
  deadline       DateTime?
  eligibilityCriteria String?
  contactEmail   String?
  associationId  String?
  association    Association?   @relation(fields: [associationId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User            @relation("OpportunityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  status         OpportunityStatus @default(PUBLISHED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  publishedAt    DateTime?
  archivedAt     DateTime?
  moderationStatus ContentModerationStatus @default(APPROVED)
  canonicalUrl   String?
  sourceName     String?
  copyrightFlag  Boolean           @default(false)
  relevanceDecision Json?

  applications OpportunityApplication[]
  savedBy       SavedOpportunity[]

  @@index([status, createdAt])
  @@index([type, status])
  @@index([status, deadline])
  @@index([associationId])
  @@index([createdById])
  @@map("opportunities")
}

model OpportunityApplication {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicantId   String
  applicant     User        @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  message       String?     @db.Text
  coverLetter   String?     @db.Text
  cvUrl         String?
  status        OpportunityApplicationStatus @default(PENDING)
  createdAt     DateTime    @default(now())

  @@unique([opportunityId, applicantId])
  @@index([opportunityId])
  @@index([applicantId])
  @@map("opportunity_applications")
}

model SavedOpportunity {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([opportunityId, userId])
  @@index([userId, createdAt])
  @@map("saved_opportunities")
}

model Post {
  id           String         @id @default(cuid())
  content      String         @db.Text
  type         PostType       @default(GENERAL)
  visibility   PostVisibility @default(PUBLIC)
  authorId     String
  author       User           @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  associationId String?
  association  Association?   @relation(fields: [associationId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  likes    PostLike[]
  comments PostComment[]

  @@index([visibility, createdAt])
  @@index([authorId, createdAt])
  @@index([associationId, createdAt])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
  publishedAt DateTime?
  archivedAt DateTime?
  moderationStatus ContentModerationStatus @default(APPROVED)
  canonicalUrl String?
  sourceName String?
  copyrightFlag Boolean @default(false)
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("PostCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("post_comments")
}

model Conversation {
  id             String   @id @default(cuid())
  participant1Id String
  participant1   User     @relation("ConversationParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2Id String
  participant2   User     @relation("ConversationParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages Message[]

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id, updatedAt])
  @@index([participant2Id, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId, isRead])
  @@map("messages")
}
