generator client {
  provider = "prisma-client-js" // <-- CORRIGÉ ICI
  output   = "../app/generated/prisma"
}

 datasource db {
  provider = "postgresql"
   // url / directUrl sont définis dans prisma.config.ts (système Prisma 7)
} 




enum Role {
  USER
  ADMIN
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum AssociationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Continent {
  id   String @id @default(uuid())
  name String
  slug String @unique
  code String @unique

  countries Country[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("continents")
}

model Country {
  id   String @id @default(uuid())
  name String
  slug String @unique
  code String @unique

  continentId String
  continent   Continent @relation(fields: [continentId], references: [id], onDelete: Restrict)

  cities City[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([continentId])
  @@map("countries")
}

model City {
  id   String @id @default(uuid())
  name String
  slug String @unique

  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  latitude  Float
  longitude Float

  profiles     Profile[]
  associations Association[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
  @@map("cities")
}

model User {
  id    String @id
  email String @unique
  role  Role   @default(USER)

  profile Profile?

  importBatchesCreated  ImportBatch[]  @relation("ImportBatchCreator")
  importBatchesReviewed ImportBatch[]  @relation("ImportBatchReviewer")
  importRecordsImported ImportRecord[] @relation("ImportRecordImporter")
  importRecordsReviewed ImportRecord[] @relation("ImportRecordReviewer")
  importRecordsPublished ImportRecord[] @relation("ImportRecordPublisher")
  articles              Article[]       @relation("ArticleAuthor")
  announcementsOwned    Announcement[]  @relation("AnnouncementOwner")
  shopsOwned            Shop[]          @relation("ShopOwner")
  consents              UserConsent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Profile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName  String
  lastName   String
  bio        String?
  profession String?
  photo      String?

  connectionsSent     Connection[] @relation("ConnectionRequester")
  connectionsReceived Connection[] @relation("ConnectionReceiver")

  visibility ProfileVisibility @default(PUBLIC)

  cityId String?
  city   City?   @relation(fields: [cityId], references: [id], onDelete: Restrict)

  associations AssociationMember[] 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId])
  @@index([visibility])
  @@map("profiles")
}

model Association {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  logo        String?
  website     String?
  email       String?
  phone       String?

  cityId String?
  city   City?   @relation(fields: [cityId], references: [id], onDelete: Restrict)

  status AssociationStatus @default(PENDING)

  members AssociationMember[]
  shops   Shop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId])
  @@index([status])
  @@map("associations")
}

model AssociationMember {
  id String @id @default(uuid())

  associationId String
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([associationId, profileId])
  @@index([associationId])
  @@index([profileId])
  @@map("association_members")
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ImportBatchStatus {
  DRAFT
  VALIDATED
  REJECTED
  IMPORTED
}

enum ImportRecordStatus {
  IMPORTED
  VALIDATED
  REJECTED
}

enum ImportEntityType {
  ASSOCIATION
  COMPANY
  PERSONALITY
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnnouncementStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AnnouncementTargetType {
  ASSOCIATION
  CONTINENT
  COUNTRY
  CITY
}

enum ShopStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ConsentType {
  ADVERTISING
  COMMUNICATIONS
}

model Connection {
  id          String           @id @default(uuid())
  requesterId String
  requester   Profile          @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    Profile          @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([receiverId])
  @@index([requesterId])
  @@map("connections")
}

model ImportBatch {
  id           String            @id @default(uuid())
  source       String
  sourceType   String
  sourceUrl    String?
  status       ImportBatchStatus @default(DRAFT)
  createdById  String
  createdBy    User              @relation("ImportBatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedById String?
  reviewedBy   User?             @relation("ImportBatchReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  reviewedAt   DateTime?

  records ImportRecord[]

  @@index([status])
  @@index([createdById])
  @@map("import_batches")
}

model ImportRecord {
  id                String             @id @default(uuid())
  batchId           String
  batch             ImportBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  entityType        ImportEntityType
  rowNumber         Int
  externalId        String?
  sourceExternalKey String?
  normalizedName    String
  dedupeKey         String
  payload           Json
  status            ImportRecordStatus  @default(IMPORTED)
  importedAt        DateTime            @default(now())
  importedById      String
  importedBy        User                @relation("ImportRecordImporter", fields: [importedById], references: [id], onDelete: Restrict)
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        User?               @relation("ImportRecordReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason   String?
  publishedAt       DateTime?
  publishedById     String?
  publishedBy       User?               @relation("ImportRecordPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedEntityId String?

  @@unique([batchId, rowNumber])
  @@unique([entityType, dedupeKey])
  @@unique([sourceExternalKey])
  @@index([batchId, status])
  @@index([status])
  @@index([publishedEntityId])
  @@map("import_records")
}

model Article {
  id          String        @id @default(uuid())
  authorId    String
  author      User          @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  title       String
  slug        String        @unique
  summary     String?
  content     String
  imageUrl    String?
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
  @@map("articles")
}

model Announcement {
  id          String             @id @default(uuid())
  ownerId     String
  owner       User               @relation("AnnouncementOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  title       String
  description String
  imageUrl    String?
  destination String?
  status      AnnouncementStatus @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  targets AnnouncementTarget[]

  @@index([status, startsAt, endsAt])
  @@index([ownerId])
  @@map("announcements")
}

model AnnouncementTarget {
  id             String                @id @default(uuid())
  announcementId String
  announcement   Announcement          @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  type           AnnouncementTargetType
  value          String
  createdAt      DateTime              @default(now())

  @@unique([announcementId, type, value])
  @@index([type, value])
  @@map("announcement_targets")
}

model Shop {
  id           String     @id @default(uuid())
  ownerId      String
  owner        User       @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  associationId String?
  association  Association? @relation(fields: [associationId], references: [id], onDelete: SetNull)
  name         String
  slug         String     @unique
  description  String?
  status       ShopStatus @default(DRAFT)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  products Product[]

  @@index([status])
  @@index([ownerId])
  @@index([associationId])
  @@map("shops")
}

model Product {
  id          String        @id @default(uuid())
  shopId      String
  shop        Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String?
  price       Decimal?      @db.Decimal(12, 2)
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([shopId, status])
  @@map("products")
}

model UserConsent {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  granted   Boolean     @default(false)
  grantedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, type])
  @@index([type, granted])
  @@map("user_consents")
}
