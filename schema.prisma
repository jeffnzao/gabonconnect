// GabonConnect — Fondation de données MVP
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
  // url / directUrl sont définis dans prisma.config.ts (nouveau système Prisma 7)
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum AssociationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────
// GÉOGRAPHIE : Continent → Country → City
// ─────────────────────────────────────────────

model Continent {
  id   String @id @default(uuid())
  name String
  slug String @unique
  code String @unique // ex: "AF", "EU"

  countries Country[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("continents")
}

model Country {
  id   String @id @default(uuid())
  name String
  slug String @unique
  code String @unique // ex: "GA", "FR" (ISO 3166-1 alpha-2)

  continentId String
  continent   Continent @relation(fields: [continentId], references: [id], onDelete: Restrict)

  cities City[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Recherche fréquente : "tous les pays d'un continent"
  @@index([continentId])
  @@map("countries")
}

model City {
  id   String @id @default(uuid())
  name String
  slug String @unique

  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  latitude  Float
  longitude Float

  profiles     Profile[]
  associations Association[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Recherche fréquente : "toutes les villes d'un pays"
  @@index([countryId])
  @@map("cities")
}

// ─────────────────────────────────────────────
// IDENTITÉ : User (auth) → Profile (données publiques)
// ─────────────────────────────────────────────

model User {
  // Doit correspondre à l'id généré par Supabase Auth (auth.users.id),
  // donc pas de @default(uuid()) ici : l'id est fourni à la création.
  id    String @id
  email String @unique
  role  Role   @default(USER)

  profile Profile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Profile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // onDelete: Cascade ici uniquement (pas géographique) : si un compte
  // utilisateur est supprimé, son profil applicatif doit disparaître avec lui.

  firstName  String
  lastName   String
  bio        String?
  profession String?
  photo      String? // chemin/clé de l'objet dans le bucket Supabase Storage (privé)

  visibility Visibility @default(PUBLIC)

  cityId String?
  city   City?  @relation(fields: [cityId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Recherche fréquente : "profils publics d'une ville", annuaire
  @@index([cityId])
  @@index([visibility])
  @@map("profiles")
}

// ─────────────────────────────────────────────
// ASSOCIATIONS
// ─────────────────────────────────────────────

model Association {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  logo        String? // chemin/clé de l'objet dans le bucket Supabase Storage
  website     String?
  email       String?
  phone       String?

  cityId String?
  city   City?   @relation(fields: [cityId], references: [id], onDelete: Restrict)

  status AssociationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Recherche fréquente : "associations d'une ville", modération admin par statut
  @@index([cityId])
  @@index([status])
  @@map("associations")
}
